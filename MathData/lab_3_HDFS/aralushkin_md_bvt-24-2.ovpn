# Профиль студенческого VPN учебного стенда МТУСИ.
# Один на всех: доступ разграничивается логином и паролем FreeIPA,
# а не файлом. При подключении спросит имя пользователя и пароль.

client
dev tun
proto tcp
remote 37.230.233.211 1195
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth-user-pass
data-ciphers AES-256-GCM:AES-128-GCM
auth SHA256
verb 3

